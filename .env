# ── Authentication API ──────────────────────────────────────────────────────
# URL base del backend (POST /api/v1/auth/login)
AUTH_BASE_URL=http://localhost:8081

# Habilitar llamadas reales a la API (false = solo bypass local)
AUTH_USE_API=true

# Sesiones basadas en cookies (false = usar Bearer token en headers)
AUTH_USE_COOKIES=false

# Bypass para desarrollo: permite admin/admin sin llamar a la API
# ⚠️ NO usar en producción
AUTH_DEV_BYPASS=true

# ── Vite (web) ─────────────────────────────────────────────────────────────
VITE_AUTH_BASE_URL=http://localhost:8081
VITE_AUTH_USE_API=true
VITE_AUTH_USE_COOKIES=false
VITE_AUTH_DEV_BYPASS=true

# ── Sync API ────────────────────────────────────────────────────────────────
SYNC_BASE_URL=http://localhost:8081
VITE_SYNC_BASE_URL=http://localhost:8081
