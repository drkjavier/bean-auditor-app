# PostHog Analytics (open-source, self-hosted)
# Obtener el API key después de levantar PostHog (http://localhost:8000)

# API Key de PostHog (requerido) - reemplazar con tu API key real
POSTHOG_API_KEY=

# Host de PostHog (self-hosted local)
POSTHOG_HOST=http://localhost:8000

# Variables para Vite (web) - prefijo VITE_
VITE_POSTHOG_API_KEY=
VITE_POSTHOG_HOST=http://localhost:8000

# --- Otras variables del proyecto ---

# MapTiler Maps API (high-precision maps)
# Obtener API key en: https://cloud.maptiler.com/account/keys/
# Plan gratuito: 100K requests/mes, 5K sessions/mes
MAPTILER_API_KEY=

# API de autenticación
AUTH_BASE_URL=http://localhost:3000
AUTH_USE_COOKIES=true
TOKEN_REFRESH_WINDOW_MS=30000
